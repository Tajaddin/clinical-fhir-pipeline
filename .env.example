# Copy to .env. Nothing here is required for the local pipeline; the API needs the keys.

# Lakehouse root: a local folder, or abfs://<container>@<account>.dfs.core.windows.net/<prefix> with the
# AZURE_STORAGE_* variables below (delta-rs object store).
CFP_LAKEHOUSE_ROOT=data/lakehouse
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=

# Secret salt for the per-patient date shift and the pseudonymous ids; `cfp silver` refuses to run without one
# of at least 32 characters. Generate it with `openssl rand -hex 32`. Rotate = new pseudonyms.
CFP_DEID_SALT=

# API keys as key:role pairs; roles are analyst (read cohort, risk, summaries) and admin (also the audit log).
# There are no default keys: generate each with `openssl rand -hex 32`, e.g. <analyst-key>:analyst,<admin-key>:admin
CFP_API_KEYS=
CFP_RATE_LIMIT=60/minute
# Proxies trusted to set X-Forwarded-For (uvicorn forwarded_allow_ips); "*" only when nothing else can reach the API
CFP_FORWARDED_ALLOW_IPS=127.0.0.1
# Compose only: first three octets of its /24 network (the dashboard proxy is .10); change it if the default
# collides with a network on this machine.
# CFP_SUBNET_PREFIX=172.30.110

# Audit log and stored summaries. SQLite for a laptop, Postgres in Compose and in the cloud.
CFP_DATABASE_URL=sqlite:///data/cfp.db
# CFP_DATABASE_URL=postgresql+psycopg://cfp:cfp@localhost:5437/cfp

# LLM for patient summaries: any OpenAI-compatible endpoint. Ollama locally (free, no key); unset = fake model.
CFP_LLM_BASE_URL=http://localhost:11434/v1
CFP_LLM_MODEL=qwen2.5:3b
CFP_LLM_API_KEY=
CFP_EMBED_MODEL=nomic-embed-text

# Observability
CFP_LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
