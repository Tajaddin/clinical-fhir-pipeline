{
  "uid": "cfp-api",
  "title": "Clinical FHIR pipeline API",
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Requests per second by route",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (route) (rate(http_request_duration_seconds_count[2m]))", "legendFormat": "{{route}}" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Latency p50 / p95 / p99 (summaries excluded)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{route!~\"/patients/\\\\{patient_id\\\\}/summary|/metrics\"}[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{route!~\"/patients/\\\\{patient_id\\\\}/summary|/metrics\"}[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{route!~\"/patients/\\\\{patient_id\\\\}/summary|/metrics\"}[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 3, "type": "stat", "title": "5xx share (10m)",
      "gridPos": { "x": 0, "y": 8, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.05 }] } } },
      "targets": [{ "expr": "sum(rate(http_request_duration_seconds_count{status=~\"5..\"}[10m])) / sum(rate(http_request_duration_seconds_count[10m]))" }]
    },
    {
      "id": 4, "type": "stat", "title": "Live summary faithfulness",
      "gridPos": { "x": 4, "y": 8, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0.9 }] } } },
      "targets": [{ "expr": "summary_faithfulness_rate{source=\"live\"}" }]
    },
    {
      "id": 5, "type": "stat", "title": "Offline eval faithfulness",
      "gridPos": { "x": 8, "y": 8, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [{ "expr": "summary_faithfulness_rate{source=\"offline_eval\"}" }]
    },
    {
      "id": 6, "type": "stat", "title": "Audit write failures (1h)",
      "gridPos": { "x": 12, "y": 8, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "targets": [{ "expr": "sum(increase(audit_write_failures_total[1h]))" }]
    },
    {
      "id": 7, "type": "stat", "title": "Auth denied (1h)",
      "gridPos": { "x": 16, "y": 8, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase(auth_denied_total[1h]))" }]
    },
    {
      "id": 8, "type": "stat", "title": "Rate limited (1h)",
      "gridPos": { "x": 20, "y": 8, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase(rate_limit_rejections_total[1h]))" }]
    },
    {
      "id": 9, "type": "timeseries", "title": "Audit rows per minute by action",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (action) (increase(audit_rows_total[1m]))", "legendFormat": "{{action}}" }]
    },
    {
      "id": 10, "type": "timeseries", "title": "Summary generation seconds (p50 / p95)",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(summary_generation_seconds_bucket[10m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(summary_generation_seconds_bucket[10m])))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 11, "type": "timeseries", "title": "Patient reads per minute by route",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (route) (increase(patient_reads_total[1m]))", "legendFormat": "{{route}}" }]
    },
    {
      "id": 12, "type": "stat", "title": "Model",
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "textMode": "name" },
      "targets": [{ "expr": "model_info", "legendFormat": "{{version}} ({{champion}})" }]
    }
  ]
}
