# Rendered by the nginx image's envsubst at start-up into /etc/nginx/conf.d/default.conf. Only DNS_RESOLVER
# is substituted (set by 10-resolver.envsh); nginx's own $variables stay as they are.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
  add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'" always;

  # Resolve the API's name per request so a recreated container is found at its new address.
  resolver ${DNS_RESOLVER} valid=10s ipv6=off;
  set $api http://api:8000;

  location /api/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $api;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 180s;
  }
  location / {
    try_files $uri $uri/ /index.html;
  }
}
